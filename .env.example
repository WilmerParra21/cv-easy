# URL de la aplicación (actualiza esto después de desplegar en Vercel)
VITE_APP_URL=https://simple-cv-craft-52.vercel.app

# Client ID OAuth 2.0 de Google (tipo aplicación web). Debe incluir tu dominio
# en "Orígenes autorizados de JavaScript" y tener Drive API habilitada.
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Cuando compres un dominio personalizado, actualiza a:
# VITE_APP_URL=https://tu-dominio.com
